---
interface Props {
  num: string;
  kicker: string;
  title: string;
  tagline?: string;
}
const { num, kicker, title, tagline } = Astro.props;
---

<header class="shead">
  <span class="ghost" aria-hidden="true">{num}</span>
  <div class="kicker"><span>{num}</span>{kicker}</div>
  <div class="row">
    <h2>{title}</h2>
    <slot />
  </div>
  {tagline && <p class="tagline">{tagline}</p>}
</header>

<style>
  .shead { position: relative; margin-bottom: 52px; }
  .ghost {
    position: absolute;
    right: 0;
    top: -24px;
    font-family: var(--serif);
    font-size: clamp(96px, 14vw, 170px);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(93, 202, 165, 0.14);
    pointer-events: none;
    user-select: none;
  }
  .kicker {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--accent);
  }
  .kicker::before { content: ''; width: 28px; height: 1px; background: var(--accent); }
  .kicker span { color: var(--fg); }
  .kicker span::after { content: ' —'; color: var(--muted); }
  .row { position: relative; display: flex; align-items: flex-end; flex-wrap: wrap; gap: 12px 24px; margin-top: 6px; }
  h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(48px, 7.5vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .tagline {
    position: relative;
    margin-top: 14px;
    max-width: 620px;
    font-family: var(--serif);
    font-size: clamp(17px, 1.9vw, 21px);
    line-height: 1.4;
    color: var(--muted);
  }
</style>
