<canvas id="net" aria-hidden="true"></canvas>

<style>
  #net { position: fixed; inset: 0; z-index: 0; pointer-events: none; opacity: 1; }
</style>

<script>
  const c = document.getElementById('net') as HTMLCanvasElement;
  const ctx = c.getContext('2d')!;
  const dpr = window.devicePixelRatio || 1;
  const LINK = 140;
  type P = { x: number; y: number; vx: number; vy: number; r: number };
  let W = 0, H = 0, pts: P[] = [];

  // The pointer (mouse or finger). `strength` fades the cursor links in and out,
  // so a finger lifting off the screen lets the connections dissolve smoothly.
  const pointer = { x: -999, y: -999, strength: 0, radius: 180, touching: false };

  function seed() {
    // keep enough nodes on small phone screens for touches to have something to connect to
    const n = Math.max(36, Math.min(90, Math.floor((W * H) / 16000)));
    pts = Array.from({ length: n }, () => ({
      x: Math.random() * W, y: Math.random() * H,
      vx: (Math.random() - 0.5) * 0.25, vy: (Math.random() - 0.5) * 0.25,
      r: Math.random() * 1.4 + 0.6,
    }));
  }

  function size() {
    const widthChanged = innerWidth !== W;
    W = innerWidth; H = innerHeight;
    c.width = W * dpr; c.height = H * dpr;
    c.style.width = W + 'px'; c.style.height = H + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    // mobile browsers fire resize when the address bar hides; only reseed on real width changes
    if (widthChanged || pts.length === 0) seed();
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    if (!pointer.touching && pointer.radius > 180) pointer.strength = Math.max(0, pointer.strength - 0.025);
    const s = pointer.strength;

    for (let i = 0; i < pts.length; i++) {
      const p = pts[i];
      p.x += p.vx; p.y += p.vy;
      if (p.x < 0 || p.x > W) p.vx *= -1;
      if (p.y < 0 || p.y > H) p.vy *= -1;

      for (let j = i + 1; j < pts.length; j++) {
        const q = pts[j];
        const d = Math.hypot(p.x - q.x, p.y - q.y);
        if (d < LINK) {
          ctx.strokeStyle = `rgba(110,231,190,${(1 - d / LINK) * 0.34})`;
          ctx.lineWidth = 0.8;
          ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y); ctx.stroke();
        }
      }

      if (s > 0) {
        const md = Math.hypot(p.x - pointer.x, p.y - pointer.y);
        if (md < pointer.radius) {
          ctx.strokeStyle = `rgba(110,231,190,${(1 - md / pointer.radius) * 0.6 * s})`;
          ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(pointer.x, pointer.y); ctx.stroke();
        }
      }

      ctx.fillStyle = 'rgba(130,240,200,.95)';
      ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill();
    }

    // small glowing node under a finger, so touches feel connected
    if (s > 0 && pointer.radius > 180) {
      ctx.fillStyle = `rgba(130,240,200,${0.9 * s})`;
      ctx.beginPath(); ctx.arc(pointer.x, pointer.y, 2.5, 0, Math.PI * 2); ctx.fill();
      ctx.strokeStyle = `rgba(130,240,200,${0.25 * s})`;
      ctx.beginPath(); ctx.arc(pointer.x, pointer.y, 10, 0, Math.PI * 2); ctx.stroke();
    }

    requestAnimationFrame(draw);
  }

  // mouse (phones also fire a synthetic mousemove after each tap; ignore those)
  let lastTouch = 0;
  addEventListener('mousemove', (e) => {
    if (performance.now() - lastTouch < 1000) return;
    Object.assign(pointer, { x: e.clientX, y: e.clientY, strength: 1, radius: 180 });
  });
  document.addEventListener('mouseleave', () => { pointer.strength = 0; });

  // touch: connect on every tap and while dragging/scrolling, then fade out on release
  const onTouch = (e: TouchEvent) => {
    const t = e.touches[0];
    if (!t) return;
    lastTouch = performance.now();
    Object.assign(pointer, { x: t.clientX, y: t.clientY, strength: 1, radius: 220, touching: true });
  };
  addEventListener('touchstart', onTouch, { passive: true });
  addEventListener('touchmove', onTouch, { passive: true });
  const onRelease = () => { pointer.touching = false; lastTouch = performance.now(); };
  addEventListener('touchend', onRelease, { passive: true });
  addEventListener('touchcancel', onRelease, { passive: true });

  addEventListener('resize', size);
  size();
  draw();
</script>
