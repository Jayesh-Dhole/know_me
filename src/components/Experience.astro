---
import { experience, education } from '../data/profile';
import SectionHead from './SectionHead.astro';
---

<section id="experience" class="wrap reveal">
  <SectionHead num="03" kicker="// git log --career" title="Experience" tagline="Where the commits turned into a career." />

  <ol class="timeline">
    {experience.map((x, i) => (
      <li class:list={['item', { current: i === 0 }]}>
        <div class="when">{x.period}<span>{x.location}</span></div>
        <div class="body">
          <h3>{x.role}</h3>
          <div class="org">{x.company}</div>
          <ul>{x.points.map((p) => <li>{p}</li>)}</ul>
        </div>
      </li>
    ))}
  </ol>

  <h3 class="subhead">Education</h3>
  <ol class="timeline">
    {education.map((e) => (
      <li class="item">
        <div class="when">{e.period}<span>{e.score}</span></div>
        <div class="body">
          <h3>{e.degree}</h3>
          <div class="org">{e.school}</div>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .timeline { list-style: none; position: relative; }
  /* the vertical line */
  .timeline::before {
    content: ''; position: absolute; top: 10px; bottom: 10px; left: 196px; width: 1px;
    background: linear-gradient(var(--accent), var(--line) 60%, transparent);
  }
  .item { position: relative; display: grid; grid-template-columns: 170px 1fr; gap: 52px; padding-bottom: 52px; }
  .item:last-child { padding-bottom: 0; }
  /* the node on the line */
  .item::before {
    content: ''; position: absolute; left: 191px; top: 9px; width: 11px; height: 11px;
    border-radius: 50%; background: var(--bg); border: 1px solid var(--accent);
  }
  .item.current::before { background: var(--accent); box-shadow: 0 0 0 5px rgba(93, 202, 165, 0.15); }

  .when { font-family: var(--mono); font-size: 13px; color: var(--fg); padding-top: 2px; text-align: right; line-height: 1.8; }
  .when span { display: block; color: var(--muted); font-size: 12px; }
  h3 { font-family: var(--serif); font-weight: 500; font-size: clamp(22px, 2.4vw, 26px); line-height: 1.25; }
  .org { font-family: var(--mono); font-size: 13px; color: var(--accent); margin-top: 4px; }
  ul { margin-top: 14px; padding-left: 18px; color: var(--muted); font-size: 0.96em; }
  ul li + li { margin-top: 8px; }
  ul li::marker { color: var(--accent); }

  @media (max-width: 760px) {
    .timeline::before { left: 5px; }
    .item { grid-template-columns: 1fr; gap: 8px; padding-left: 32px; padding-bottom: 44px; }
    .item::before { left: 0; top: 7px; }
    .when { text-align: left; }
    .when span { display: inline; margin-left: 10px; }
  }
</style>
