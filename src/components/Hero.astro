---
import { profile } from '../data/profile';
import Icon from './Icon.astro';

const socials = [
  { icon: 'mail', href: `mailto:${profile.email}`, label: 'Email' },
  { icon: 'linkedin', href: profile.socials.linkedin, label: 'LinkedIn' },
  { icon: 'github', href: profile.socials.github, label: 'GitHub' },
  { icon: 'award', href: profile.socials.credly, label: 'Credly' },
] as const;
---

<script is:inline>
  // Hide the hero text before first paint so the intro animation doesn't flash.
  // If the animation script never runs, show everything after 3s anyway.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('intro');
    setTimeout(function () {
      if (!window.__introStarted) document.documentElement.classList.remove('intro');
    }, 3000);
  }
</script>

<header id="top" class="hero wrap">
  <div class="eyebrow" data-type>&lt;hello world /&gt; <span>I'm</span></div>
  <h1 data-scramble>{profile.name}</h1>
  <div class="role" data-type>
    {profile.headline.split('*').map((part, i) => (i % 2 ? <span>{part}</span> : part))}
  </div>
  <div class="meta intro-fade">
    <span>{profile.stack.join(' · ')}</span>
    <span class="loc"><Icon name="pin" size={14} />{profile.location}</span>
  </div>
  <p class="lead intro-fade">{profile.lead}</p>

  <div class="actions intro-fade">
    <a href="#work" class="btn solid">view my work</a>
    <a href={profile.resume} class="btn" download><Icon name="download" size={15} />résumé</a>
  </div>

  <ul class="socials intro-fade">
    {socials.map((s) => (
      <li>
        <a href={s.href} target={s.icon === 'mail' ? undefined : '_blank'} rel="noopener" aria-label={s.label} title={s.label}>
          <Icon name={s.icon} size={18} />
        </a>
      </li>
    ))}
  </ul>
</header>

<style>
  .hero {
    min-height: calc(100svh - 64px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-top: 48px;
    padding-bottom: 64px;
  }
  .eyebrow { font-family: var(--mono); font-size: 13px; color: var(--accent); letter-spacing: 0.08em; margin-bottom: 18px; }
  .eyebrow span { color: var(--fg); margin-left: 6px; }
  h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(46px, 8vw, 96px); line-height: 1; letter-spacing: -0.01em; }
  .role { font-family: var(--serif); font-size: clamp(20px, 2.6vw, 28px); color: var(--muted); margin-top: 16px; }
  .role span { color: var(--fg); }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 22px; font-family: var(--mono); font-size: 13px; color: var(--accent); margin-top: 10px; }
  .loc { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); }
  .lead { max-width: 560px; margin: 32px 0 40px; color: var(--muted); }
  .actions { display: flex; gap: 14px; flex-wrap: wrap; }

  .socials { display: flex; gap: 10px; list-style: none; margin-top: 40px; }
  .socials a {
    display: grid; place-items: center; width: 40px; height: 40px;
    border: 1px solid var(--line); border-radius: 50%; color: var(--muted);
    transition: 0.25s;
  }
  .socials a:hover { color: var(--accent); border-color: var(--accent); transform: translateY(-2px); }

  /* ---------- intro animation ---------- */
  :global(html.intro) .hero :is([data-type], [data-scramble], .intro-fade) { visibility: hidden; }
  /* hide instantly, animate only when revealing */
  .intro-fade { transition: opacity 0.8s ease, transform 0.8s ease; }
  .intro-fade:global(.pre) { opacity: 0; transform: translateY(12px); transition: none; }
  :global(.caret) {
    display: inline-block;
    width: max(2px, 0.06em);
    height: 0.95em;
    margin-left: 0.08em;
    vertical-align: -0.1em;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  :global(.glyph) { color: var(--accent); opacity: 0.75; }
  @keyframes blink { 50% { opacity: 0; } }

  /* phones / narrow screens */
  @media (max-width: 760px) {
    .hero { min-height: 80svh; padding-top: 56px; padding-bottom: 72px; }
    .lead { margin: 24px 0 32px; }
  }

  /* landscape phones: short screens, keep things compact */
  @media (orientation: landscape) and (max-height: 520px) {
    .hero { min-height: auto; padding-top: 32px; padding-bottom: 48px; }
    .lead { margin: 18px 0 24px; }
    .socials { margin-top: 24px; }
  }
</style>

<script>
  (window as Window & { __introStarted?: boolean }).__introStarted = true;

  const root = document.documentElement;
  const hero = document.querySelector<HTMLElement>('.hero');
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const GLYPHS = '!<>-_/[]{}=+*^?#01$%&';
  const caret = Object.assign(document.createElement('span'), { className: 'caret' });

  function textNodes(el: HTMLElement) {
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    const out: Text[] = [];
    while (walker.nextNode()) out.push(walker.currentNode as Text);
    return out;
  }

  // Prepare an element for typing: remember its text, empty it, keep its height.
  function prepareType(el: HTMLElement) {
    el.style.minHeight = el.offsetHeight + 'px';
    const parts = textNodes(el).map((node) => ({ node, text: node.textContent ?? '' }));
    parts.forEach((p) => (p.node.textContent = ''));
    return { el, parts };
  }

  async function type(job: ReturnType<typeof prepareType>, speed: number) {
    for (const { node, text } of job.parts) {
      node.after(caret);
      for (let i = 1; i <= text.length; i++) {
        node.textContent = text.slice(0, i);
        if (text[i - 1].trim()) await sleep(speed);
      }
    }
    job.el.style.minHeight = '';
  }

  // "Decode" text: random code glyphs resolve into the real letters, left to right.
  function scramble(el: HTMLElement, text: string, duration: number) {
    return new Promise<void>((resolve) => {
      const start = performance.now();
      let last = 0;
      const frame = (now: number) => {
        const p = Math.min(1, (now - start) / duration);
        if (now - last > 45 || p === 1) {
          last = now;
          const done = Math.floor(p * text.length);
          el.textContent = text.slice(0, done);
          for (const ch of text.slice(done)) {
            if (ch === ' ') { el.append(' '); continue; }
            const g = document.createElement('span');
            g.className = 'glyph';
            g.textContent = GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
            el.append(g);
          }
          el.append(caret);
        }
        if (p < 1) requestAnimationFrame(frame);
        else { el.textContent = text; resolve(); }
      };
      requestAnimationFrame(frame);
    });
  }

  async function intro(hero: HTMLElement) {
    const [eyebrow, role] = [...hero.querySelectorAll<HTMLElement>('[data-type]')].map(prepareType);
    const name = hero.querySelector<HTMLElement>('[data-scramble]')!;
    const fullName = name.textContent ?? '';
    name.style.visibility = 'hidden';
    const fades = [...hero.querySelectorAll<HTMLElement>('.intro-fade')];
    fades.forEach((f) => f.classList.add('pre'));
    root.classList.remove('intro');

    await sleep(250);
    await type(eyebrow, 45);
    await sleep(150);
    name.style.visibility = '';
    await scramble(name, fullName, 950);
    await sleep(120);
    await type(role, 24);
    for (const f of fades) {
      f.classList.remove('pre');
      await sleep(130);
    }
    setTimeout(() => caret.remove(), 2200);
  }

  if (hero && root.classList.contains('intro')) intro(hero);
  else root.classList.remove('intro');
</script>
