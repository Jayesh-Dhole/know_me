---
import { profile } from '../data/profile';
import Icon from './Icon.astro';

const socials = [
  { icon: 'mail', href: `mailto:${profile.email}`, label: 'Email' },
  { icon: 'linkedin', href: profile.socials.linkedin, label: 'LinkedIn' },
  { icon: 'github', href: profile.socials.github, label: 'GitHub' },
  { icon: 'award', href: profile.socials.credly, label: 'Credly' },
] as const;
---

<header id="top" class="hero wrap">
  <div class="photo">
    <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="180" height="180" />
  </div>

  <div class="eyebrow">&lt;hello world /&gt;</div>
  <h1>{profile.name}</h1>
  <div class="role">{profile.role} at <span>{profile.company}</span></div>
  <div class="meta">
    <span>{profile.stack.join(' · ')}</span>
    <span class="loc"><Icon name="pin" size={14} />{profile.location}</span>
  </div>
  <p class="lead">{profile.lead}</p>

  <div class="actions">
    <a href="#work" class="btn solid">view my work</a>
    <a href={profile.resume} class="btn" download><Icon name="download" size={15} />résumé</a>
  </div>

  <ul class="socials">
    {socials.map((s) => (
      <li>
        <a href={s.href} target={s.icon === 'mail' ? undefined : '_blank'} rel="noopener" aria-label={s.label} title={s.label}>
          <Icon name={s.icon} size={18} />
        </a>
      </li>
    ))}
  </ul>
</header>

<style>
  .hero {
    min-height: calc(100svh - 64px);
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'eyebrow photo'
      'name    photo'
      'role    photo'
      'meta    photo'
      'lead    lead'
      'actions actions'
      'socials socials';
    align-content: center;
    column-gap: 48px;
    padding-top: 48px;
    padding-bottom: 64px;
  }
  .eyebrow { grid-area: eyebrow; font-family: var(--mono); font-size: 13px; color: var(--accent); letter-spacing: 0.08em; margin-bottom: 18px; }
  h1 { grid-area: name; font-family: var(--serif); font-weight: 400; font-size: clamp(46px, 8vw, 96px); line-height: 1; letter-spacing: -0.01em; }
  .role { grid-area: role; font-family: var(--serif); font-size: clamp(20px, 2.6vw, 28px); color: var(--muted); margin-top: 16px; }
  .role span { color: var(--fg); }
  .meta { grid-area: meta; display: flex; flex-wrap: wrap; gap: 6px 22px; font-family: var(--mono); font-size: 13px; color: var(--accent); margin-top: 10px; }
  .loc { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); }
  .lead { grid-area: lead; max-width: 560px; margin: 32px 0 40px; color: var(--muted); }
  .actions { grid-area: actions; display: flex; gap: 14px; flex-wrap: wrap; }

  .socials { grid-area: socials; display: flex; gap: 10px; list-style: none; margin-top: 40px; }
  .socials a {
    display: grid; place-items: center; width: 40px; height: 40px;
    border: 1px solid var(--line); border-radius: 50%; color: var(--muted);
    transition: 0.25s;
  }
  .socials a:hover { color: var(--accent); border-color: var(--accent); transform: translateY(-2px); }

  /* small round profile photo with a soft accent ring */
  .photo { grid-area: photo; align-self: center; justify-self: end; position: relative; padding: 6px; border-radius: 50%; border: 1px solid rgba(93, 202, 165, 0.45); }
  .photo::after {
    content: ''; position: absolute; inset: -10px; border-radius: 50%;
    border: 1px dashed rgba(93, 202, 165, 0.18);
  }
  .photo img {
    width: clamp(110px, 16vw, 180px); height: clamp(110px, 16vw, 180px);
    border-radius: 50%; object-fit: cover; object-position: center 20%;
    filter: grayscale(0.2) contrast(1.05); transition: filter 0.4s;
  }
  .photo:hover img { filter: none; }

  /* phones / narrow screens: photo on top, everything stacked */
  @media (max-width: 760px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      grid-template-areas: 'photo' 'eyebrow' 'name' 'role' 'meta' 'lead' 'actions' 'socials';
      padding-top: 48px;
      padding-bottom: 72px;
    }
    .photo { justify-self: start; margin-bottom: 32px; }
    .lead { margin: 24px 0 32px; }
  }

  /* landscape phones: short screens, keep things compact */
  @media (orientation: landscape) and (max-height: 520px) {
    .hero { min-height: auto; padding-top: 32px; padding-bottom: 48px; }
    .photo img { width: 96px; height: 96px; }
    .lead { margin: 18px 0 24px; }
    .socials { margin-top: 24px; }
  }
</style>
