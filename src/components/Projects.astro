---
import { projects } from '../data/profile';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
---

<section id="work" class="wrap reveal">
  <SectionHead num="04" kicker="work" title="Selected projects" />
  <div class="grid">
    {projects.map((p, i) => (
      <article class="card">
        <div class="top">
          <span class="folder"><Icon name="folder" size={26} /></span>
          <span class="idx">/{String(i + 1).padStart(2, '0')}</span>
        </div>
        <h3>
          {p.link ? <a href={p.link} target="_blank" rel="noopener">{p.name}</a> : p.name}
        </h3>
        <div class="ctx">{p.context}</div>
        <p>{p.description}</p>
        <div class="bottom">
          <div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
          {p.link && (
            <a class="gh" href={p.link} target="_blank" rel="noopener" aria-label={`${p.name} on GitHub`}>
              <Icon name="github" size={18} />
            </a>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: 20px; }
  .card {
    position: relative;
    display: flex; flex-direction: column;
    min-height: 340px;
    padding: 28px 26px 24px;
    background: var(--card);
    border: 1px solid var(--line);
    transition: transform 0.3s, border-color 0.3s;
  }
  .card:hover { transform: translateY(-6px); border-color: rgba(93, 202, 165, 0.5); }
  .top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 26px; }
  .folder { color: var(--accent); }
  .idx { font-family: var(--mono); font-size: 12px; color: var(--muted); }
  h3 { font-family: var(--serif); font-weight: 500; font-size: 24px; line-height: 1.25; transition: color 0.2s; }
  .card:hover h3 { color: var(--accent); }
  /* make the whole card clickable when it has a link */
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .ctx { font-family: var(--mono); font-size: 12px; color: var(--muted); margin-top: 6px; }
  p { color: var(--muted); margin: 16px 0 22px; font-size: 16px; line-height: 1.65; }
  .bottom { margin-top: auto; display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; }
  .gh { position: relative; z-index: 1; color: var(--muted); transition: color 0.2s; }
  .gh:hover { color: var(--accent); }
  @media (max-width: 520px) { .card { min-height: 0; } }
</style>
